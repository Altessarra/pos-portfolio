PORT=5000
NODE_ENV=production

# Put your deployed website URL here.
# Example: https://your-pos-app.onrender.com
CLIENT_URL=https://your-deployed-domain.com

# Hosted PostgreSQL connection string.
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Most hosted PostgreSQL services require SSL.
DB_SSL=true

# Use a long random secret. Never commit your real secret to GitHub.
JWT_SECRET=replace_this_with_a_very_long_random_production_secret
JWT_EXPIRES_IN=7d
